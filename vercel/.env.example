# OneNYC intake API — serverless (Vercel) environment variables
# Copy to .env.local for local dev; production values live in the Vercel dashboard
# (Project Settings → Environment Variables) or via `vercel env add`.

# --- Required (Vercel-provided) ---
BLOB_READ_WRITE_TOKEN=          # set automatically by Vercel when Blob store is linked

# --- Optional: org mailbox provisioning (Microsoft Graph) ---
ORG_MAIL_GRAPH_TOKEN=           # bearer token; when unset, addresses are only reserved
GRAPH_TOKEN_ONENYC=

# --- Optional: SharePoint upload + status (client credentials) ---
MSGRAPH_ONENYC_TENANT_ID=
MSGRAPH_TENANT_ID_ONENYC=
MSGRAPH_ONENYC_CLIENT_ID=
MSGRAPH_CLIENT_ID_ONENYC=
MSGRAPH_ONENYC_CLIENT_SECRET=
MSGRAPH_ONENYC_SECRET=
SHAREPOINT_SITE=netorg19167036.sharepoint.com:/sites/onenycworkinggroup
SHAREPOINT_UPLOAD_FOLDER=Intake
SHAREPOINT_ADMIN=mohamed@onenyc.com
